{
  "name": "MATRIX4-XMD",
  "description": "MATRIX4-XMD WhatsApp bot with MongoDB-backed sessions and channel auto-reactions",
  "keywords": [
    "MATRIX4-XMD",
    "WhatsApp",
    "MongoDB",
    "Channel-Reaction"
  ],
  "success_url": "/",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "PORT": {
      "description": "Port for web app.4000,5000,3000... any!",
      "value": "5000",
      "required": false
    },
    "MONGODB_URI": {
      "description": "MongoDB Atlas connection URI (required; keep private)",
      "required": true
    },
    "MONGODB_DB": {
      "description": "MongoDB database name",
      "value": "rich_md",
      "required": false
    },
    "BOT_NAME": {
      "description": "Bot display name",
      "value": "MATRIX4-XMD",
      "required": false
    },
    "CHANNEL_JID": {
      "description": "Primary WhatsApp Channel JID (the three auto-follow channels are fixed in main.js)",
      "value": "120363429745743429@newsletter",
      "required": false
    },
    "REACT_EMOJI": {
      "description": "Emoji used for channel auto-reactions",
      "value": "🫴",
      "required": false
    },
    "BOT_OWNER": {
      "description": "Owner WhatsApp number in international format (digits only)",
      "required": false,
      "value": "255674017300"
    },
    "OWNER_NAME": {
      "description": "Owner display name (optional)",
      "required": false,
      "value": "CYBER MATRIX4"
    }
  }
}
